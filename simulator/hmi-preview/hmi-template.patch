+    lv_label_set_text(lv_obj_get_child(b, 0), "");
+    lv_obj_t *o = plain(b);
+    lv_obj_set_size(o, 21, 12);
+    lv_obj_align(o, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_add_event_cb(o, arrow_draw, LV_EVENT_DRAW_MAIN, up ? (void *)1 : NULL);
+}
